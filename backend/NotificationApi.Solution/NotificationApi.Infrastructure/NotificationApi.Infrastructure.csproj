<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- MailKit and QRCoder are added with:
         dotnet add NotificationApi.Infrastructure package MailKit
         dotnet add NotificationApi.Infrastructure package QRCoder -->
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotificationApi.Application\NotificationApi.Application.csproj" />
  </ItemGroup>

</Project>
